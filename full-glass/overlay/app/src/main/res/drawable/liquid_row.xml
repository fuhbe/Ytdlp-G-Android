<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/liquid_ripple">
    <item>
        <inset android:insetLeft="10dp" android:insetRight="10dp" android:insetTop="4dp" android:insetBottom="4dp">
            <shape>
                <solid android:color="?attr/liquidCardFill" />
                <corners android:radius="18dp" />
                <stroke android:width="1dp" android:color="?attr/liquidGlassEdge" />
            </shape>
        </inset>
    </item>
    <item android:id="@android:id/mask">
        <inset android:insetLeft="10dp" android:insetRight="10dp" android:insetTop="4dp" android:insetBottom="4dp">
            <shape><solid android:color="@android:color/white" /><corners android:radius="18dp" /></shape>
        </inset>
    </item>
</ripple>
